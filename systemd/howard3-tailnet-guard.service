[Unit]
Description=Hold Tailscale down on untrusted Wi-Fi
After=dbus.socket
Wants=dbus.socket
ConditionPathExists=%h/.config/omarchy/plugins/howard3.tailnet-guard/bin/tailnet-guard

[Service]
Type=simple
ExecStart=%h/.config/omarchy/plugins/howard3.tailnet-guard/bin/tailnet-guard run
Restart=always
RestartSec=1
TimeoutStopSec=8
KillMode=control-group

[Install]
WantedBy=default.target
WantedBy=graphical-session-pre.target
